{
  "schema_version": "1.0.0",
  "fingerprints": {
    "Acme": {
      "cpe": [
        "cpe:2.3:a:acme:acme:*:*:*:*:*:*:*:*"
      ],
      "headers": {
        "X-Acme": [
          "acme/([\\d.]+)\\;version:\\1"
        ]
      },
      "html": [
        "acme-v([\\d.]+)\\;version:\\1"
      ]
    }
  }
}
