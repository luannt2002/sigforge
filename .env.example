# SigForge — operator configuration template. Copy to .env and set what you need.
#
# EVERY value is OFF by default (empty = no network). The code hard-codes NO source
# URL; the operator chooses every endpoint here. The "# example:" lines are the public
# canonical sources, shown as guidance only — copy one into the variable to enable it.
# Per-source licensing and whether a point-in-time snapshot is embedded is in NOTICE.

# ── Fingerprint / tech-detect source adapters (merge --fetch) ──
# Community fingerprint datasets. Third-party data is fetched by the operator, never
# vendored into this repo; provenance + license are tagged per entry.
SIGFORGE_SOURCE_WEBAPPANALYZER_URL=   # example: a WebAppAnalyzer technologies JSON (GPL-3.0)
SIGFORGE_SOURCE_NUCLEI_URL=           # example: nuclei tech-detect templates (MIT). Rules with unsupported semantics (AND / negative / multi-request) are QUARANTINED, never silently downgraded.
SIGFORGE_SOURCE_WHATWEB_URL=          # example: WhatWeb plugins (GPL-2.0-or-later)

# ── CVE / EOL intelligence (per-detected-tech lookups; empty = that lookup is off) ──
SIGFORGE_SOURCE_CVE_URL=              # example: https://services.nvd.nist.gov/rest/json/cves/2.0  (CPE -> CVE, NVD)
SIGFORGE_SOURCE_ENDOFLIFE_URL=        # example: https://endoflife.date/api  (version -> lifecycle/EOL)
SIGFORGE_SOURCE_KEV_URL=              # empty = embedded CISA KEV snapshot (public domain); set to the live catalog to upgrade.
SIGFORGE_SOURCE_EPSS_URL=             # example: FIRST.org EPSS. NOT embedded (no permissive reuse licence) — empty = no EPSS score.
SIGFORGE_SOURCE_CPE_DICT_URL=         # empty = embedded NVD CPE sample (public domain); set to the full dictionary for wider CPE identity coverage.

# ── Ecosystem / library / platform vulnerability intel ──
SIGFORGE_SOURCE_OSV_URL=              # example: https://osv-vulnerabilities.storage.googleapis.com  (ecosystem+package -> CVE). NOT embedded (OSV aggregate includes CC-BY-NC-ND) — empty = off.
SIGFORGE_SOURCE_RETIREJS_URL=         # empty = embedded Retire.js snapshot (Apache-2.0); set to the live jsrepository for the full set.
SIGFORGE_SOURCE_TAKEOVER_URL=         # empty = embedded can-i-take-over-xyz snapshot (CC-BY-4.0); set to the live fingerprints for fresh data.
SIGFORGE_SOURCE_WPVULN_URL=           # WordPress plugin/theme vulnerability feed. NOT embedded (per-record attribution) — empty = off.
SIGFORGE_SOURCE_WPORG_URL=            # WordPress.org plugins/themes directory API (provenance: in-directory vs not) — empty = off.
