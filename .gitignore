# Built binaries (Go output has no extension — regenerated via `go build`)
/sigforge
/cmd/sigforge/sigforge

# Secrets and local environment
.env
.env.local

# Operator-generated merged DB + fetched-source caches (contain third-party data under their own licenses —
# never committed; the operator generates/holds them locally and points consumers at them via env path)
*.merged.json
.cache/

# Per-source sync marker written by `merge --fetch` — operator-generated metadata about third-party fetches
# (URLs, versions, counts), never committed
SYNC-MANIFEST.json

# Local Claude operating-rules — NOT part of the public product
/CLAUDE.md

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.tmp
